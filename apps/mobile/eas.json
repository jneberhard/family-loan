{
  "cli": {
    "version": ">=24.12.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_ADMOB_TEST_ADS": "true" },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_ADMOB_TEST_ADS": "false" },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
