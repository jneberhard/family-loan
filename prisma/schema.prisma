generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_USER
  ADMIN
  CHILD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FamilyPlan {
  FREE
  MONTHLY
  YEARLY
  LEGACY
}

enum BillingStatus {
  NONE
  INCOMPLETE
  ACTIVE
  PAST_DUE
  CANCELED
}

enum EntryType {
  LOAN
  PAYMENT
  INTEREST
  ADJUSTMENT
  RATE_CHANGE
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum DeletionRequestSource {
  IN_APP
  WEB
}

model Family {
  id                 String         @id @default(cuid())
  name               String
  interestPostingDay Int            @default(1)
  approvalStatus     ApprovalStatus @default(PENDING)
  plan               FamilyPlan     @default(LEGACY)
  billingStatus      BillingStatus  @default(NONE)
  stripeCustomerId   String?        @unique
  stripeSubscriptionId String?      @unique
  subscriptionPeriodEnd DateTime?
  cancelAtPeriodEnd  Boolean        @default(false)
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  users              User[]
  accounts           LoanAccount[]
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  passwordHash        String
  role                UserRole
  familyId            String?
  family              Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childAccount        LoanAccount? @relation("ChildLogin")
  sessionVersion      Int          @default(1)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean      @default(false)
  lastLoginAt         DateTime?
  mfaSecret           String?
  mfaEnabledAt        DateTime?
  mfaRecoveryCodes    String[]     @default([])
  deletedAt           DateTime?
  auditLogs           AuditLog[]   @relation("AuditActor")
  mobileSessions      MobileSession[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([familyId])
  @@index([role])
}

model LoanAccount {
  id                    String        @id @default(cuid())
  name                  String
  relationship          String?       @default("Child")
  email                 String
  annualRate            Decimal       @db.Decimal(6, 3)
  familyId              String
  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childUserId           String?       @unique
  childUser             User?         @relation("ChildLogin", fields: [childUserId], references: [id], onDelete: SetNull)
  transactions          LedgerEntry[]
  balanceReminderDay    Int?
  lastBalanceReminderAt DateTime?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([familyId, deletedAt])
}

model LedgerEntry {
  id          String      @id @default(cuid())
  accountId   String
  account     LoanAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        EntryType
  effectiveAt DateTime
  description String
  amount      Decimal     @db.Decimal(14, 2)
  rate        Decimal?    @db.Decimal(6, 3)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([accountId, effectiveAt])
  @@index([accountId, deletedAt, effectiveAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  familyId   String?
  accountId  String?
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([accountId, createdAt])
  @@index([actorId, createdAt])
}

model AccountDeletionRequest {
  id          String                @id @default(cuid())
  requesterId String?
  familyId    String?
  accountId   String?
  name        String
  email       String
  role        UserRole
  source      DeletionRequestSource
  status      DeletionRequestStatus @default(PENDING)
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@index([familyId, createdAt])
}

model RateLimitBucket {
  key             String   @id
  windowStartedAt DateTime
  count           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model MobileSession {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
