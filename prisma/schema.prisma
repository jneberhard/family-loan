generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_USER
  ADMIN
  CHILD
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntryType {
  LOAN
  PAYMENT
  INTEREST
  ADJUSTMENT
  RATE_CHANGE
}

model Family {
  id                 String         @id @default(cuid())
  name               String
  interestPostingDay Int            @default(1)
  approvalStatus     ApprovalStatus @default(PENDING)
  reviewedAt         DateTime?
  reviewNote         String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  users              User[]
  accounts           LoanAccount[]
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String
  passwordHash        String
  role                UserRole
  familyId            String?
  family              Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childAccount        LoanAccount? @relation("ChildLogin")
  sessionVersion      Int          @default(1)
  failedLoginAttempts Int          @default(0)
  lockedUntil         DateTime?
  mustChangePassword  Boolean      @default(false)
  lastLoginAt         DateTime?
  deletedAt           DateTime?
  auditLogs           AuditLog[]   @relation("AuditActor")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([familyId])
  @@index([role])
}

model LoanAccount {
  id                    String        @id @default(cuid())
  name                  String
  relationship          String?       @default("Child")
  email                 String
  annualRate            Decimal       @db.Decimal(6, 3)
  familyId              String
  family                Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  childUserId           String?       @unique
  childUser             User?         @relation("ChildLogin", fields: [childUserId], references: [id], onDelete: SetNull)
  transactions          LedgerEntry[]
  balanceReminderDay    Int?
  lastBalanceReminderAt DateTime?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([familyId, deletedAt])
}

model LedgerEntry {
  id          String      @id @default(cuid())
  accountId   String
  account     LoanAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type        EntryType
  effectiveAt DateTime
  description String
  amount      Decimal     @db.Decimal(14, 2)
  rate        Decimal?    @db.Decimal(6, 3)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([accountId, effectiveAt])
  @@index([accountId, deletedAt, effectiveAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  familyId   String?
  accountId  String?
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@index([familyId, createdAt])
  @@index([accountId, createdAt])
  @@index([actorId, createdAt])
}
